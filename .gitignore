# ---- append these lines to the repository-root .gitignore --------------

# Egg images: large, and not redistributed with the repository
Artefact/data/images/
Artefact/data/raw/

# Trained weights: regenerable, too large for git (use a release asset if needed)
Artefact/models/*.pt
Artefact/models/*.pth
Artefact/models/*.ckpt
Artefact/models/*.onnx

# Transfer archives produced by tools/collect_outputs.py
eggshell_outputs*.zip

# Python / Jupyter noise
__pycache__/
*.pyc
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.venv/
.env

# NOTE: Artefact/results/ and Artefact/data/processed/ are deliberately NOT ignored.
# They are the evidence for Chapter 5 and must be committed. master_table.csv
# references images by file name only, so it is portable between machines.
