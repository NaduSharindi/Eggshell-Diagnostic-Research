<View>
  <View style="display:flex; gap:16px;">
    <View style="flex:65%;">
      <Image name="img" value="$image" zoom="true" zoomControl="true"
             brightnessControl="true" contrastControl="true" maxWidth="100%"/>
    </View>

    <View style="flex:35%;">
      <Header value="1. Egg status"/>
      <Choices name="egg_status" toName="img" choice="single" required="true">
        <Choice value="Intact" hotkey="1"/>
        <Choice value="Micro_cracked" hotkey="2"/>
      </Choices>

      <View visibleWhen="choice-selected" whenTagName="egg_status" whenChoiceValue="Micro_cracked">
        <Header value="2. Crack pattern"/>
        <Choices name="crack_pattern" toName="img" choice="single" required="true">
          <Choice value="Hairline" hotkey="q"/>
          <Choice value="Star" hotkey="w"/>
          <Choice value="Network" hotkey="e"/>
        </Choices>
      </View>

      <Header value="3. Crack outline (only for the chosen subset)"/>
      <PolygonLabels name="crack_region" toName="img" strokeWidth="2" opacity="0.3">
        <Label value="Crack" background="red" hotkey="c"/>
      </PolygonLabels>

      <TextArea name="notes" toName="img" placeholder="Notes (type check if unsure)" rows="2"/>
    </View>
  </View>
</View>
